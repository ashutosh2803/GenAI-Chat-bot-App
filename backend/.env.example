# PostgreSQL with the pgvector extension.
# Matches the pgvector/pgvector Docker example in the readme.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/genai_chat

# Used to sign login sessions. Change this before sharing the app.
JWT_SECRET=dev-only-change-this-secret

# Same Web client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Vector size for the messages.embedding column. Change only before the first run.
EMBEDDING_DIMENSIONS=1536

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_CONTEXT_LIMIT=128000
